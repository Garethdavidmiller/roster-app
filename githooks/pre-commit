#!/usr/bin/env bash
# Checks that every root-level module (.js and .mjs) is listed in both AI_MAP and FILE_INDEX,
# among the other checks below. Blocks the commit if any module is missing from either file.
# To install: git config core.hooksPath githooks

cd "$(git rev-parse --show-toplevel)"

# ── THE DOCUMENTS THIS HOOK READS, DECLARED ONCE (v22.48) ──────────────────────────────────────
#
# They moved to docs/ at v22.47 and this hook did not follow, in FOUR places at once — the module
# listing, the staged-AI_MAP detection, the export-drift diff and the 0.10 stamp list. The two
# halves failed in opposite directions and only one of them was visible:
#
#   * the module check went LOUD and WRONG — `grep AI_MAP.md` on a path that no longer exists
#     reported all 149 root modules as undocumented and refused every commit;
#   * the stamp check went SILENT — it skipped any file it could not find, so four of the five
#     versioned documents simply stopped being checked, and nothing said so.
#
# Neither is visible to CI (no workflow installs this hook) or to a container that never ran
# `git config core.hooksPath githooks`. Every path is now a variable, exported so the embedded
# node scripts read the same value, and `pre-commit-parity.test.mjs` asserts each one exists — so
# the next reorganisation fails in the test suite rather than in somebody's terminal.
export DOC_AI_MAP="docs/AI_MAP.md"
export DOC_CLAUDE="CLAUDE.md"
# The one-line-per-file catalogue left CLAUDE.md on 11 Sep 2026. The module check follows it —
# grepping CLAUDE.md for a module name now finds nothing, which would refuse every commit.
export DOC_FILE_INDEX="docs/FILE_INDEX.md"
export DOC_OPERATIONS="docs/OPERATIONS_REFERENCE.md"
export DOC_KNOWN_LIMITATIONS="docs/KNOWN_LIMITATIONS.md"
export DOC_ROADMAP="docs/ROADMAP.md"

for _doc in "$DOC_AI_MAP" "$DOC_CLAUDE" "$DOC_FILE_INDEX" "$DOC_OPERATIONS" "$DOC_KNOWN_LIMITATIONS" "$DOC_ROADMAP"; do
  if [ ! -f "$_doc" ]; then
    echo "  pre-commit: $_doc does not exist — this hook cannot check what it cannot read."
    echo "  Fix the path at the top of githooks/pre-commit (and pre-commit-parity.test.mjs will agree)."
    exit 1
  fi
done

ERRORS=0
HOOK_TMP=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX") || { echo "  pre-commit: could not make a temporary folder."; exit 1; }
trap 'rm -rf "$HOOK_TMP"' EXIT

# A step that cannot run must SAY so: skipped in silence, it is indistinguishable from one that
# looked and was satisfied (the ESLint branch below learned this at v23.63). A GUI client's hook
# PATH often has no `node`, and every node step used to vanish there without a word.
if command -v node >/dev/null 2>&1; then HAVE_NODE=1; else HAVE_NODE=""; fi
not_checked() {
  echo "  $1 DID NOT RUN — node is not on this hook's PATH, so this commit was NOT checked for it."
}

# ── WHAT IS BEING COMMITTED, READ ONCE (whole-app check, 10 November 2026) ─────────────────────
#
# Every check below reads THE COMMIT — the index — never the working tree, and all of them read the
# same list. Before this, the module check grepped the documents ON DISK, so a module staged with
# its two documentation lines written but not `git add`-ed passed and was committed without them;
# ESLint linted the working copy of a half-staged file; and the lint and export-drift steps each kept
# their own filter, `.js` only and Added/Copied/Modified only — so every `.mjs`, every Cloud Function
# and every renamed file went in unlinted, and a renamed module escaped export drift. NUL-separated,
# so a name with a space survives; STAGED_RENAMES pairs each renamed path with its old one.
STAGED_FILES=""
STAGED_RENAMES=""
while IFS= read -r -d '' _status; do
  IFS= read -r -d '' _path
  case "$_status" in
    R*|C*)
      _old="$_path"
      IFS= read -r -d '' _path
      if [[ "$_status" == R* ]]; then STAGED_RENAMES+="$_old"$'\t'"$_path"$'\n'; fi
      ;;
  esac
  STAGED_FILES+="$_path"$'\n'
done < <(git diff --cached --name-status -M --diff-filter=ACMR -z)

# A root application MODULE: the rule doc-parity.test.mjs applies (its NOT_ROUTED set and its
# runner-config rule), stated ONCE for the listing check and the export-drift check. A test is
# `*.test.*`, as there — `*test*` also skipped any module whose name merely contained "test".
is_module() {
  case "$1" in
    */*|*.test.*) return 1 ;;
    eslint.config.js|generate-sri.mjs|purify.es.mjs|playwright.*) return 1 ;;
    *.js|*.mjs) return 0 ;;
  esac
  return 1
}
STAGED_MODULES=""
while IFS= read -r _f; do
  if [[ -n "$_f" ]] && is_module "$_f"; then STAGED_MODULES+="$_f"$'\n'; fi
done <<< "$STAGED_FILES"
export STAGED_FILES STAGED_RENAMES STAGED_MODULES

# ── EVERY MODULE IN THE COMMIT IS DOCUMENTED IN THE COMMIT ─────────────────────────────────────
# The documents AS STAGED, and a mention matched as a whole file name: `grep -q picker.js` matched
# `date-picker.js`, so a new `picker.js` passed with no entry at all — and five existing modules
# are the tail of another's name (guide-search.js, leave-year.js, ls.js, overlay.js, session.js).
git show ":$DOC_AI_MAP" > "$HOOK_TMP/ai-map" 2>/dev/null
git show ":$DOC_FILE_INDEX" > "$HOOK_TMP/file-index" 2>/dev/null
mentions() {   # mentions <file> <module name>
  grep -Eq -- "(^|[^A-Za-z0-9_.-])${2//./\\.}([^A-Za-z0-9_-]|$)" "$1"
}
while IFS= read -r -d '' f; do
  is_module "$f" || continue
  if ! mentions "$HOOK_TMP/ai-map" "$f"; then
    echo "  doc-check: $f not listed in $DOC_AI_MAP (as staged)"
    ERRORS=$((ERRORS + 1))
  fi
  if ! mentions "$HOOK_TMP/file-index" "$f"; then
    echo "  doc-check: $f not listed in $DOC_FILE_INDEX (as staged)"
    ERRORS=$((ERRORS + 1))
  fi
done < <(git ls-files -z -- '*.js' '*.mjs')

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "  Add the missing module(s) to $DOC_AI_MAP and $DOC_FILE_INDEX, stage both, then re-commit."
  exit 1
fi

# Roster-members sync check — functions/roster-members.json must be exactly what
# scripts/generate-roster-members.mjs builds from roster-data.js. Adding a member without
# re-running generate:roster-members silently breaks uploads. sw-asset-check.test.mjs checks the
# same property in CI.
#
# It used to RUN that test, picked by a title substring nothing pinned, against the WORKING TREE:
# a JSON regenerated but left unstaged passed here and was missing from the commit, and a reworded
# title would have matched no test at all, which `node --test` reports as a pass. It now builds the
# file with the generator's own buildRosterMembers() over the modules AS STAGED, and compares it
# with the JSON as staged. The root modules are copied out of the index, so imports resolve as they
# will in the commit.
if [[ -n "$HAVE_NODE" ]]; then
  export ROSTER_TMP="$HOOK_TMP/roster"
  mkdir -p "$ROSTER_TMP"
  git ls-files -z -- ':(glob)*.js' ':(glob)*.mjs' package.json 'scripts/*.mjs' functions/roster-members.json \
    | xargs -0 git checkout-index --prefix="$ROSTER_TMP/" --
  node --input-type=module - << 'NODEEOF'
import { readFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';
import { isDeepStrictEqual } from 'node:util';

const root = process.env.ROSTER_TMP;
let expected, committed;
try {
    const { buildRosterMembers } = await import(pathToFileURL(`${root}/scripts/generate-roster-members.mjs`).href);
    expected = JSON.parse(JSON.stringify(buildRosterMembers()));   // as the generator writes it
    committed = JSON.parse(readFileSync(`${root}/functions/roster-members.json`, 'utf8'));
} catch (e) {
    process.stderr.write(`  roster-members: could not build the member list from the staged files — ${e && e.message}\n`);
    process.exit(1);
}
if (!isDeepStrictEqual(committed, expected)) {
    process.stderr.write('  roster-members: functions/roster-members.json, as staged, is not what roster-data.js\n'
        + '  (as staged) generates.\n');
    process.exit(1);
}
NODEEOF
  if [ $? -ne 0 ]; then
    echo "  Run: npm run generate:roster-members — and stage functions/roster-members.json with it."
    exit 1
  fi
else
  not_checked "The roster-members sync check"
fi

# Export-drift same-commit check — if a staged JS module CHANGES its exported
# surface (adds, removes or renames a symbol) vs HEAD, AI_MAP.md must be updated
# in the SAME commit. Generalises the module add/remove rule at the top of this
# hook to cover changed exports (the gap that let applyHuddleButtonState linger
# in the docs after v12.57).
#
# ⚠ IT USED TO CHECK ONLY REMOVALS, AND THAT WAS THE WHOLE BUG (v21.63). The hook was
# written in response to a REMOVAL, so it computed `removed` and stopped — an export
# ADDED without documentation passed cleanly, every time. Audited at v21.62: 73 of 847
# root exports (8.6%) had ZERO mention anywhere in AI_MAP.md, and every single defect
# pointed the same way — nothing documented had been deleted, so the asymmetry was not
# luck, it was this line. `auth-policy.js`'s `canOpenOvertime`/`isOvertimeReviewer` (the
# Overtime permission gates) and ten of `paycalc-calc.js`'s pay constants were among
# them. Adding to a documented API is the COMMON case; leaving it unchecked meant the
# gate fired on the rare direction and slept through the frequent one.
if [[ -n "$HAVE_NODE" ]]; then
  node - << 'NODEEOF'
const { execSync } = require('child_process');
const sh = c => { try { return execSync(c, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'] }); } catch { return null; } };

// The path comes from the hook's own DOC_AI_MAP, never a literal — the heredoc is quoted, so an
// interpolated path would be a second copy free to drift from the first.
const AI_MAP = process.env.DOC_AI_MAP;
const list = (/** @type {string} */ v) => (process.env[v] || '').split('\n').filter(Boolean);
const aiMapStaged = list('STAGED_FILES').includes(AI_MAP);
// The modules the hook selected once (is_module), so this and the listing check agree; a renamed
// one is compared with its OLD path at HEAD, not skipped as new.
const jsFiles = list('STAGED_MODULES');
const renamedFrom = new Map(list('STAGED_RENAMES').map(l => l.split('\t')).map(([from, to]) => [to, from]));

function exportsOf(src) {
    const names = new Set();
    // export [async] function|const|let|var|class NAME
    const declRe = /export\s+(?:async\s+)?(?:function\*?|const|let|var|class)\s+([A-Za-z0-9_$]+)/g;
    let m;
    while ((m = declRe.exec(src))) names.add(m[1]);
    // export { a, b as c } and re-exports export { x as y } from '...'.
    // Re-exported names are part of the module's documented surface too
    // (e.g. firebase-client.js re-exports the Firestore helpers listed in
    // AI_MAP), so removing one should also trip this gate.
    const blockRe = /export\s*\{([^}]*)\}/g;
    while ((m = blockRe.exec(src))) {
        for (const part of m[1].split(',')) {
            const seg = part.trim();
            if (!seg) continue;
            const as = seg.match(/\bas\s+([A-Za-z0-9_$]+)/);
            const name = as ? as[1] : seg.split(/\s+/)[0];
            if (name && name !== 'default') names.add(name);
        }
    }
    return names;
}

const offenders = [];
for (const f of jsFiles) {
    const head = sh(`git show HEAD:"${renamedFrom.get(f) ?? f}"`);
    if (head == null) continue;                  // new file — covered by the module-listing check
    const now = sh(`git show :"${f}"`);
    if (now == null) continue;
    const before = exportsOf(head), after = exportsOf(now);
    const removed = [...before].filter(n => !after.has(n));
    const added   = [...after].filter(n => !before.has(n));
    // BOTH directions (v21.63). A rename shows up as one of each, which is what the old
    // removal-only check was really catching; a plain addition showed up as neither.
    const changes = [
        ...removed.map(n => `-${n}`),
        ...added.map(n => `+${n}`),
    ];
    if (changes.length) offenders.push({ f, changes, names: [...removed, ...added] });
}

if (offenders.length && !aiMapStaged) {
    for (const o of offenders) process.stderr.write(`  export-drift: changed export(s) in ${o.f}: ${o.changes.join(', ')}\n`);
    process.stderr.write('\n  An added, removed or renamed export changes the module documented API.\n');
    process.stderr.write(`  Update ${AI_MAP} (and CLAUDE.md if its file-structure line names the export)\n`);
    process.stderr.write('  in the SAME commit, then re-commit.\n');
    process.exit(1);
}

// …and STAGING AI_MAP is not the same as DOCUMENTING the change (v21.63). The old gate
// was satisfied by any AI_MAP edit at all, which is how commit 07f28d9 shipped three new
// `override-utils.js` exports with an AI_MAP diff that touched only an unrelated heading.
// Require the staged AI_MAP diff to at least MENTION the module or one of the changed
// symbols. Deliberately a mention and not a section-diff: cheap, no false positives worth
// the noise, and it closes the "edited something else entirely" hole.
if (offenders.length) {
    const aiDiff = sh(`git diff --cached -U0 -- "${AI_MAP}"`) || '';
    const unmentioned = offenders.filter(o =>
        !aiDiff.includes(o.f) && !o.names.some(n => aiDiff.includes(n)));
    if (unmentioned.length) {
        for (const o of unmentioned) {
            process.stderr.write(`  export-drift: ${AI_MAP} is staged but never mentions ${o.f} or ${o.changes.join(', ')}\n`);
        }
        process.stderr.write(`\n  Staging ${AI_MAP} is not the same as documenting the change.\n`);
        process.stderr.write('  Update the entry for the module whose exports changed.\n');
        process.exit(1);
    }
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
else
  not_checked "The export-drift check"
fi

# ESLint — run on the staged JS (fast).
#
# ── RESOLVING THE BINARY FROM A WORKTREE (v23.63) ──────────────────────────────────────────────
#
# `git rev-parse --show-toplevel` names the WORKTREE root when the commit is made from one, and a
# worktree never has `node_modules` — it is gitignored, so `git worktree add` does not copy it and
# nobody installs into a throwaway checkout. The probe here was a bare `./node_modules/.bin/eslint`,
# so from every `.claude/worktrees/*` tree this step printed one line and passed having linted
# nothing. That is the v22.48 stamp-check shape again: a step that SKIPS what it cannot find is
# indistinguishable, at the terminal, from one that looked and was satisfied. Reproduced before
# fixing — a staged `no-undef` committed cleanly from a worktree with the hook installed.
#
# `--git-common-dir` names the MAIN checkout's `.git` from anywhere in the family, so its parent is
# the tree where `npm install` actually ran. The worktree's own install is tried first, so a tree
# that does have one is never made to borrow. In an ordinary checkout the second candidate resolves
# to the same path as the first, which is why there is no separate branch for that case.
ESLINT_BIN=""
for _candidate in \
    "./node_modules/.bin/eslint" \
    "$(dirname "$(git rev-parse --git-common-dir)")/node_modules/.bin/eslint"; do
  if [[ -x "$_candidate" ]]; then ESLINT_BIN="$_candidate"; break; fi
done

if [[ -n "$ESLINT_BIN" && -n "$HAVE_NODE" ]]; then
  # --no-warn-ignored is load-bearing (v20.11). Naming an ESLint-IGNORED file on the command line
  # makes it warn "file ignored", which --max-warnings=0 turns into a failed commit — so any commit
  # touching one is blocked for a reason that is not a lint problem. This block used to handle that
  # by filtering out the one ignored path anybody had hit (service-worker.js), while the ignore list
  # in eslint.config.js grew to cover e2e/**, scripts/**, four playwright configs and the test globs.
  # Staging e2e/visual.spec.js duly failed the hook. A hand-maintained mirror of another list is the
  # failure this repo keeps writing guards about; the flag tracks the real list automatically.
  # service-worker.js was filtered out here too, until the v24.28 review gave it its own block in
  # eslint.config.js (a classic worker script with serviceworker globals) — so it is linted like
  # everything else now, and the special case went with the ignore.
  #
  # EVERY staged .js and .mjs, from the one list above: tests, scripts, runner configs and the Cloud
  # Functions too, which `npm run lint` covers and this step used to filter out. A file with
  # unstaged edits is linted AS STAGED, through stdin, because the working copy is not the commit.
  _lint_failed=""
  _whole=()
  while IFS= read -r _f; do
    case "$_f" in *.js|*.mjs) ;; *) continue ;; esac
    if git diff --quiet -- "$_f"; then
      _whole+=("$_f")
    elif ! git show ":$_f" | "$ESLINT_BIN" --max-warnings=0 --no-warn-ignored --stdin --stdin-filename "$_f"; then
      _lint_failed=1
    fi
  done <<< "$STAGED_FILES"
  if [[ ${#_whole[@]} -gt 0 ]] && ! "$ESLINT_BIN" --max-warnings=0 --no-warn-ignored "${_whole[@]}"; then
    _lint_failed=1
  fi
  if [[ -n "$_lint_failed" ]]; then
    echo ""
    echo "  ESLint: fix the above warnings/errors, then re-commit."
    echo "  (Run: $ESLINT_BIN --fix <file> to auto-fix most issues.)"
    exit 1
  fi
else
  # SAY THAT NOTHING WAS CHECKED, not merely that something is missing. The old line read
  # "(node_modules/.bin/eslint not found — run: npm install)", which is a suggestion; this is a
  # statement about what this commit was and was not checked against. Deliberately NOT a refusal:
  # a bare clone with no install must still be committable, which is the same posture as
  # `npm run test:nodeps`. The parity test pins the wording so it cannot soften back. The binary is
  # a node script, so without node it cannot run either — and used to fail as though the CODE had.
  if [[ -z "$HAVE_NODE" ]]; then
    echo "  ESLint DID NOT RUN — node is not on this hook's PATH."
    echo "  Staged JS was NOT linted by this commit."
  else
    echo "  ESLint DID NOT RUN — no eslint binary in this checkout or the main one."
    echo "  Staged JS was NOT linted by this commit. Run: npm install"
  fi
fi

# service-worker.js — parsed as what it is, a CLASSIC script. ESLint's own block for it catches
# this when ESLint is installed; this is the check that remains on a bare clone, where the step
# above says it did not run. It used to be `node --check`, which in this `"type": "module"`
# package parses the worker as a MODULE, so a stray `import`, `export` or top-level `await` — fatal
# to the classic worker sw-register.js registers, which would stop every update — passed.
if [[ $'\n'"$STAGED_FILES" == *$'\n'service-worker.js$'\n'* ]]; then
  if [[ -n "$HAVE_NODE" ]]; then
    if ! git show :service-worker.js | node -e "new (require('vm').Script)(require('fs').readFileSync(0, 'utf8'), { filename: 'service-worker.js' })"; then
      echo "  service-worker.js: it does not parse as a classic script — the browser would refuse it."
      exit 1
    fi
  else
    not_checked "The service-worker syntax check"
  fi
fi

# Firebase SDK version consistency — every `firebasejs/x.y.z/` import in firebase-client.js (as
# staged) names the same version: two versions on one page is two SDKs, and the second one's state
# is invisible to the first. (The SDK pin against package.json and service-worker.js is
# dependency-pin-parity.test.mjs and sw-asset-check.test.mjs, in CI.)
if [[ -n "$HAVE_NODE" ]]; then
  git show :firebase-client.js > "$HOOK_TMP/firebase-client.js" 2>/dev/null
  export FIREBASE_CLIENT_STAGED="$HOOK_TMP/firebase-client.js"
  node - << 'NODEEOF'
const clientSrc = require('fs').readFileSync(process.env.FIREBASE_CLIENT_STAGED, 'utf8');
// The SDK is imported by URL (`…/firebasejs/12.19.0/firebase-app.js`), never as `firebase@x.y.z` —
// an earlier version of this check matched that npm spelling until Sep 2026 and so could never fire.
const importMatch = clientSrc.match(/firebasejs\/(\d+\.\d+\.\d+)\//g);
if (importMatch && importMatch.length > 1) {
    const versions = [...new Set(importMatch.map(s => s.replace(/^firebasejs\/|\/$/g, '')))];
    if (versions.length > 1) {
        process.stderr.write(`  firebase-sdk: multiple Firebase versions in firebase-client.js: ${versions.join(', ')}\n`);
        process.stderr.write('  Ensure every firebasejs/x.y.z import uses the same version.\n');
        process.exit(1);
    }
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
else
  not_checked "The Firebase SDK version check"
fi

# Documentation 0.10-checkpoint — BLOCKING for every versioned .md doc.
# Each doc's version stamp must be at least the latest 0.10 milestone at or below
# APP_VERSION. Mirrors sw-asset-check.test.mjs exactly, so a missed doc sweep fails
# at commit time locally, not only in CI. Covers ALL the docs, not just AI_MAP.
# Read AS STAGED, like every check above: the commit is what has to be swept.
if [[ -n "$HAVE_NODE" ]]; then
  node - << 'NODEEOF'
const { execFileSync } = require('child_process');
const staged = (p) => { try { return execFileSync('git', ['show', `:${p}`], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }); } catch { return null; } };
const toHundredths = v => { const [a, b = '0'] = v.split('.'); return parseInt(a, 10) * 100 + parseInt(b.padEnd(2, '0').slice(0, 2), 10); };

// AN UNREADABLE VERSION IS A FAILURE, NOT A PASS. This exited 0 when the line could not be read,
// so the whole check went quiet; and a version that is not two decimals is one the toolchain reads
// two ways (25.7 is 25.70 here and in CI, 25.07 to the service worker's ordering).
const line = ((staged('roster-data.js') || '').match(/export const APP_VERSION = '([^']*)'/) || [])[1];
if (!line || !/^\d+\.\d{2}$/.test(line)) {
    process.stderr.write(`\n  doc-checkpoint: APP_VERSION in roster-data.js (as staged) is ${line ? `'${line}'` : 'not readable'} —\n`
        + '  it must be exactly two decimals (npm run bump), so the documentation stamps were NOT checked.\n');
    process.exit(1);
}
const app = line;
const milestone = Math.floor(toHundredths(app) / 10) * 10;
const milestoneStr = `v${(milestone / 100).toFixed(2)}`;

const DOCS = [
    { file: process.env.DOC_CLAUDE,            re: /Documentation milestone[^`]*`(\d+\.\d+)`/ },
    { file: process.env.DOC_AI_MAP,            re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
    { file: process.env.DOC_OPERATIONS,        re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
    { file: process.env.DOC_KNOWN_LIMITATIONS, re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
    { file: process.env.DOC_ROADMAP,           re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
];

const stale = [];
for (const { file, re } of DOCS) {
    // A MISSING FILE IS A FAILURE, NOT A SKIP (v22.48). This was `if (!existsSync) continue`, and
    // that one word is how the docs/ move disabled four fifths of this check in silence: the paths
    // stopped resolving, every document was skipped, and the hook went on passing. A stamp check
    // that cannot find its documents has not checked them — which is the opposite of what its
    // silence claimed. The loud module check above was the only reason anyone noticed at all.
    if (!file) { stale.push('(a documentation path was not exported by the hook)'); continue; }
    const text = staged(file);
    if (text == null) { stale.push(`${file} (not in this commit — fix the path in githooks/pre-commit, or stage it)`); continue; }
    const m = text.match(re);
    if (!m) { stale.push(`${file} (no version stamp found)`); continue; }
    if (toHundredths(m[1]) < milestone) stale.push(`${file} (v${m[1]})`);
}

if (stale.length) {
    process.stderr.write(`\n  doc-checkpoint: the app has reached the ${milestoneStr} 0.10 milestone (APP_VERSION v${app}),\n`);
    process.stderr.write('  but these docs are behind it (CLAUDE.md policy: all .md docs are swept every 0.10 version):\n');
    for (const s of stale) process.stderr.write(`    - ${s}\n`);
    process.stderr.write(`\n  Review each, apply any needed updates, then bump its stamp to ${milestoneStr} (or later) and re-commit.\n`);
    process.exit(1);
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
else
  not_checked "The documentation 0.10-checkpoint"
fi
