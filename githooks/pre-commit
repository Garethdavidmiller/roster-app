#!/usr/bin/env bash
# Checks that every root-level .js module is listed in both AI_MAP.md and CLAUDE.md.
# Blocks the commit if any module is missing from either file.
# To install: git config core.hooksPath githooks

cd "$(git rev-parse --show-toplevel)"

ERRORS=0

for f in *.js; do
  [[ "$f" == *test* ]] && continue

  if ! grep -q "$f" AI_MAP.md 2>/dev/null; then
    echo "  doc-check: $f not listed in AI_MAP.md"
    ERRORS=$((ERRORS + 1))
  fi

  if ! grep -q "$f" CLAUDE.md 2>/dev/null; then
    echo "  doc-check: $f not listed in CLAUDE.md"
    ERRORS=$((ERRORS + 1))
  fi
done

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "  Add the missing module(s) to AI_MAP.md and CLAUDE.md, then re-commit."
  exit 1
fi

# STAFF_NAMES sync check — ensures functions/index.js STAFF_NAMES matches
# the active (non-hidden) members in roster-data.js teamMembers.
# Adding a new member to one file without the other silently breaks roster uploads.
if command -v node >/dev/null 2>&1; then
  node - << 'NODEEOF'
const fs = require('fs');
const rosterSrc = fs.readFileSync('roster-data.js', 'utf8');
const fnSrc     = fs.readFileSync('functions/index.js', 'utf8');

// Extract non-hidden teamMembers from roster-data.js, grouped by grade
const byGrade = { cea: new Set(), ces: new Set(), dispatcher: new Set() };
for (const line of rosterSrc.split('\n')) {
    if (!line.includes("name:") || !line.includes("rosterType:")) continue;
    if (line.includes('hidden: true')) continue;
    const name = (line.match(/name:\s*'([^']+)'/) || [])[1];
    const type = (line.match(/rosterType:\s*'([^']+)'/) || [])[1];
    if (!name || !type) continue;
    if (['main', 'bilingual', 'fixed'].includes(type)) byGrade.cea.add(name);
    else if (type === 'ces')        byGrade.ces.add(name);
    else if (type === 'dispatcher') byGrade.dispatcher.add(name);
}

// Extract STAFF_NAMES from functions/index.js
const fnGrade = { cea: new Set(), ces: new Set(), dispatcher: new Set() };
const block = fnSrc.match(/const STAFF_NAMES\s*=\s*\{([\s\S]*?)\n\s*\};/);
if (block) {
    let grade = null;
    for (const line of block[1].split('\n')) {
        const gm = line.match(/\b(cea|ces|dispatcher)\s*:/);
        if (gm) grade = gm[1];
        if (grade) {
            for (const m of line.matchAll(/'([^']+)'/g)) fnGrade[grade].add(m[1]);
            if (line.includes('],')) grade = null;
        }
    }
}

let errors = 0;
for (const grade of ['cea', 'ces', 'dispatcher']) {
    for (const n of byGrade[grade]) {
        if (!fnGrade[grade].has(n)) {
            process.stderr.write(`  staff-names: '${n}' (${grade}) is in roster-data.js but missing from functions/index.js STAFF_NAMES\n`);
            errors++;
        }
    }
    for (const n of fnGrade[grade]) {
        if (!byGrade[grade].has(n)) {
            process.stderr.write(`  staff-names: '${n}' (${grade}) is in functions/index.js STAFF_NAMES but not in roster-data.js (or is hidden)\n`);
            errors++;
        }
    }
}
if (errors > 0) {
    process.stderr.write('\n  Update STAFF_NAMES in functions/index.js to match teamMembers in roster-data.js, then re-commit.\n');
    process.exit(1);
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
fi

# Export-drift same-commit check — if a staged JS module removes or renames an
# exported symbol (its documented API shrank vs HEAD), AI_MAP.md must be updated
# in the SAME commit. Generalises the module add/remove rule at the top of this
# hook to cover changed exports (the gap that let applyHuddleButtonState linger
# in the docs after v12.57).
if command -v node >/dev/null 2>&1; then
  node - << 'NODEEOF'
const { execSync } = require('child_process');
const sh = c => { try { return execSync(c, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'] }); } catch { return null; } };

const staged = (sh('git diff --cached --name-only --diff-filter=ACMR') || '').split('\n').filter(Boolean);
const aiMapStaged = staged.includes('AI_MAP.md');
// Root JS modules only — skip tests, the SW, and functions/ (CommonJS, not in AI_MAP).
const jsFiles = staged.filter(f => /^[^/]+\.js$/.test(f) && !f.includes('.test.') && f !== 'service-worker.js');

function exportsOf(src) {
    const names = new Set();
    // export [async] function|const|let|var|class NAME
    const declRe = /export\s+(?:async\s+)?(?:function\*?|const|let|var|class)\s+([A-Za-z0-9_$]+)/g;
    let m;
    while ((m = declRe.exec(src))) names.add(m[1]);
    // export { a, b as c } and re-exports export { x as y } from '...'.
    // Re-exported names are part of the module's documented surface too
    // (e.g. firebase-client.js re-exports the Firestore helpers listed in
    // AI_MAP), so removing one should also trip this gate.
    const blockRe = /export\s*\{([^}]*)\}/g;
    while ((m = blockRe.exec(src))) {
        for (const part of m[1].split(',')) {
            const seg = part.trim();
            if (!seg) continue;
            const as = seg.match(/\bas\s+([A-Za-z0-9_$]+)/);
            const name = as ? as[1] : seg.split(/\s+/)[0];
            if (name && name !== 'default') names.add(name);
        }
    }
    return names;
}

const offenders = [];
for (const f of jsFiles) {
    const head = sh(`git show HEAD:"${f}"`);
    if (head == null) continue;                  // new file — covered by the module-listing check
    const now = sh(`git show :"${f}"`);
    if (now == null) continue;
    const removed = [...exportsOf(head)].filter(n => !exportsOf(now).has(n));
    if (removed.length) offenders.push(`${f}: ${removed.join(', ')}`);
}

if (offenders.length && !aiMapStaged) {
    for (const o of offenders) process.stderr.write(`  export-drift: removed/renamed export(s) in ${o}\n`);
    process.stderr.write('\n  A removed or renamed export changes the module documented API.\n');
    process.stderr.write('  Update AI_MAP.md (and CLAUDE.md if its file-structure line names the export)\n');
    process.stderr.write('  in the SAME commit, then re-commit. (Staging AI_MAP.md satisfies this check.)\n');
    process.exit(1);
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
fi

# ESLint — run on staged .js files only (fast; non-blocking warning if eslint not found)
if command -v eslint >/dev/null 2>&1; then
  STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' | grep -v 'node_modules\|functions/' | tr '\n' ' ')
  if [[ -n "$STAGED_JS" ]]; then
    # shellcheck disable=SC2086
    eslint --max-warnings=0 $STAGED_JS
    if [ $? -ne 0 ]; then
      echo ""
      echo "  ESLint: fix the above warnings/errors, then re-commit."
      echo "  (Run: eslint --fix <file> to auto-fix most issues.)"
      exit 1
    fi
  fi
else
  echo "  (eslint not found — skipping lint check; install with: npm install -g eslint)"
fi

# Firebase SDK version consistency check — ensures firebase.json functions and
# index.html both reference the same major.minor version of the Firebase JS SDK.
if command -v node >/dev/null 2>&1 && [[ -f "index.html" ]] && [[ -f "firebase-client.js" ]]; then
  node - << 'NODEEOF'
const fs = require('fs');
const clientSrc = fs.readFileSync('firebase-client.js', 'utf8');
const fnPkg = fs.existsSync('functions/package.json') ? JSON.parse(fs.readFileSync('functions/package.json', 'utf8')) : null;
const clientMatch = clientSrc.match(/firebase@(\d+\.\d+)/);
const clientVer = clientMatch ? clientMatch[1] : null;
const fnVer = fnPkg && fnPkg.dependencies && fnPkg.dependencies['firebase-admin']
    ? fnPkg.dependencies['firebase-admin'].replace(/[\^~>=<]*/g, '').split('.').slice(0,2).join('.')
    : null;
// Only warn; SDK versions in browser client vs Admin SDK aren't directly comparable.
// This check catches forgotten bumps within the browser SDK (firebase vs @firebase/app).
const importMatch = clientSrc.match(/firebase@(\d+\.\d+\.\d+)/g);
if (importMatch && importMatch.length > 1) {
    const versions = [...new Set(importMatch.map(s => s.replace('firebase@', '')))];
    if (versions.length > 1) {
        process.stderr.write(`  firebase-sdk: multiple Firebase versions in firebase-client.js: ${versions.join(', ')}\n`);
        process.stderr.write('  Ensure all firebase@x.y.z imports use the same version.\n');
        process.exit(1);
    }
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
fi

# Extract current app version once — shared by both reminder checks below
APP_VER=$(grep "^export const APP_VERSION" roster-data.js 2>/dev/null | grep -oP "'[0-9.]+'" | tr -d "'")
[[ -z "$APP_VER" ]] && exit 0
CUR_INT=$(echo "$APP_VER" | awk -F. '{printf "%d", $1*100+$2}')

# CLAUDE.md — remind when it falls 0.10+ behind APP_VERSION
DOC_VER=$(grep -m1 "Current app version" CLAUDE.md 2>/dev/null | grep -oP '\`[0-9.]+\`' | tr -d '`')
if [[ -n "$DOC_VER" ]]; then
  DOC_INT=$(echo "$DOC_VER" | awk -F. '{printf "%d", $1*100+$2}')
  DIFF=$((CUR_INT - DOC_INT))
  if [ "$DIFF" -ge 10 ]; then
    echo ""
    echo "  Reminder: CLAUDE.md documents v${DOC_VER} — app is now v${APP_VER} (+${DIFF} patches)"
    echo "  Update CLAUDE.md + AI_MAP.md if any architecture, module, or pay-grade changes occurred."
    echo "  (Reminder only — commit proceeds.)"
    echo ""
  fi
fi

# AI_MAP.md — BLOCKING: must be current to the latest 0.10 milestone.
# Mirrors sw-asset-check.test.mjs so a missed 0.10 doc sweep fails at commit
# time locally, not only in CI. Milestone = APP_VERSION floored to nearest 0.10.
if [[ -f "AI_MAP.md" ]]; then
  AIMAP_VER=$(grep -m1 "Last updated" AI_MAP.md 2>/dev/null | grep -oP 'v[0-9]+\.[0-9]+' | tr -d 'v')
  if [[ -n "$AIMAP_VER" ]]; then
    AIMAP_INT=$(echo "$AIMAP_VER" | awk -F. '{printf "%d", $1*100+$2}')
    MILESTONE=$(( (CUR_INT / 10) * 10 ))
    if [ "$AIMAP_INT" -lt "$MILESTONE" ]; then
      MILE_VER=$(printf "%d.%02d" $((MILESTONE / 100)) $((MILESTONE % 100)))
      echo ""
      echo "  doc-checkpoint: AI_MAP.md 'Last updated' is v${AIMAP_VER}, but the app has reached the"
      echo "  v${MILE_VER} 0.10 milestone (APP_VERSION v${APP_VER}). Per CLAUDE.md the .md files are"
      echo "  swept every 0.10 version. Review the docs, bump AI_MAP.md's 'Last updated' line to"
      echo "  v${MILE_VER} (or later), then re-commit."
      echo ""
      exit 1
    fi
  fi
fi

# KNOWN_LIMITATIONS.md, ROADMAP.md, OPERATIONS_REFERENCE.md — soft reminder when 0.20+ behind
for doc in KNOWN_LIMITATIONS.md ROADMAP.md OPERATIONS_REFERENCE.md; do
  [[ -f "$doc" ]] || continue
  DOC_VER=$(grep -m1 "Last updated" "$doc" 2>/dev/null | grep -oP 'v[0-9]+\.[0-9]+' | tr -d 'v')
  [[ -z "$DOC_VER" ]] && continue
  DOC_INT=$(echo "$DOC_VER" | awk -F. '{printf "%d", $1*100+$2}')
  DIFF=$((CUR_INT - DOC_INT))
  if [ "$DIFF" -ge 20 ]; then
    echo ""
    echo "  Reminder: ${doc} documents v${DOC_VER} — app is now v${APP_VER} (+${DIFF} patches)"
    echo "  Review ${doc} for any updates needed, then bump its 'Last updated' stamp."
    echo "  (Reminder only — commit proceeds.)"
    echo ""
  fi
done

