#!/usr/bin/env bash
# Checks that every root-level .js module is listed in both AI_MAP.md and CLAUDE.md.
# Blocks the commit if any module is missing from either file.
# To install: git config core.hooksPath githooks

cd "$(git rev-parse --show-toplevel)"

ERRORS=0

for f in *.js; do
  [[ "$f" == *test* ]] && continue
  # Tooling config files are not application modules — skip them.
  [[ "$f" == "eslint.config.js" ]] && continue

  if ! grep -q "$f" AI_MAP.md 2>/dev/null; then
    echo "  doc-check: $f not listed in AI_MAP.md"
    ERRORS=$((ERRORS + 1))
  fi

  if ! grep -q "$f" CLAUDE.md 2>/dev/null; then
    echo "  doc-check: $f not listed in CLAUDE.md"
    ERRORS=$((ERRORS + 1))
  fi
done

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "  Add the missing module(s) to AI_MAP.md and CLAUDE.md, then re-commit."
  exit 1
fi

# Roster-members sync check — ensures functions/roster-members.json matches
# the active (non-hidden, non-manager) staff in roster-data.js.
# Uses the same logic as sw-asset-check.test.mjs 'roster-members.json' test.
# Adding a new member without re-running generate:roster-members silently breaks uploads.
if command -v node >/dev/null 2>&1; then
  node --test --test-name-pattern "roster-members.json matches" sw-asset-check.test.mjs 2>&1
  if [ $? -ne 0 ]; then
    echo "  Run: npm run generate:roster-members"
    exit 1
  fi
fi

# Export-drift same-commit check — if a staged JS module removes or renames an
# exported symbol (its documented API shrank vs HEAD), AI_MAP.md must be updated
# in the SAME commit. Generalises the module add/remove rule at the top of this
# hook to cover changed exports (the gap that let applyHuddleButtonState linger
# in the docs after v12.57).
if command -v node >/dev/null 2>&1; then
  node - << 'NODEEOF'
const { execSync } = require('child_process');
const sh = c => { try { return execSync(c, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'] }); } catch { return null; } };

const staged = (sh('git diff --cached --name-only --diff-filter=ACMR') || '').split('\n').filter(Boolean);
const aiMapStaged = staged.includes('AI_MAP.md');
// Root JS modules only — skip tests, the SW, and functions/ (CommonJS, not in AI_MAP).
const jsFiles = staged.filter(f => /^[^/]+\.js$/.test(f) && !f.includes('.test.') && f !== 'service-worker.js');

function exportsOf(src) {
    const names = new Set();
    // export [async] function|const|let|var|class NAME
    const declRe = /export\s+(?:async\s+)?(?:function\*?|const|let|var|class)\s+([A-Za-z0-9_$]+)/g;
    let m;
    while ((m = declRe.exec(src))) names.add(m[1]);
    // export { a, b as c } and re-exports export { x as y } from '...'.
    // Re-exported names are part of the module's documented surface too
    // (e.g. firebase-client.js re-exports the Firestore helpers listed in
    // AI_MAP), so removing one should also trip this gate.
    const blockRe = /export\s*\{([^}]*)\}/g;
    while ((m = blockRe.exec(src))) {
        for (const part of m[1].split(',')) {
            const seg = part.trim();
            if (!seg) continue;
            const as = seg.match(/\bas\s+([A-Za-z0-9_$]+)/);
            const name = as ? as[1] : seg.split(/\s+/)[0];
            if (name && name !== 'default') names.add(name);
        }
    }
    return names;
}

const offenders = [];
for (const f of jsFiles) {
    const head = sh(`git show HEAD:"${f}"`);
    if (head == null) continue;                  // new file — covered by the module-listing check
    const now = sh(`git show :"${f}"`);
    if (now == null) continue;
    const removed = [...exportsOf(head)].filter(n => !exportsOf(now).has(n));
    if (removed.length) offenders.push(`${f}: ${removed.join(', ')}`);
}

if (offenders.length && !aiMapStaged) {
    for (const o of offenders) process.stderr.write(`  export-drift: removed/renamed export(s) in ${o}\n`);
    process.stderr.write('\n  A removed or renamed export changes the module documented API.\n');
    process.stderr.write('  Update AI_MAP.md (and CLAUDE.md if its file-structure line names the export)\n');
    process.stderr.write('  in the SAME commit, then re-commit. (Staging AI_MAP.md satisfies this check.)\n');
    process.exit(1);
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
fi

# ESLint — run on staged .js files only (fast).
# Uses project-local node_modules/.bin/eslint (installed by `npm install`).
if [[ -x "./node_modules/.bin/eslint" ]]; then
  # --no-warn-ignored is load-bearing (v20.11). Naming an ESLint-IGNORED file on the command line
  # makes it warn "file ignored", which --max-warnings=0 turns into a failed commit — so any commit
  # touching one is blocked for a reason that is not a lint problem. This block used to handle that
  # by filtering out the one ignored path anybody had hit (service-worker.js), while the ignore list
  # in eslint.config.js grew to cover e2e/**, scripts/**, four playwright configs and the test globs.
  # Staging e2e/visual.spec.js duly failed the hook. A hand-maintained mirror of another list is the
  # failure this repo keeps writing guards about; the flag tracks the real list automatically.
  # service-worker.js stays filtered for a SEPARATE reason: its coverage is `node --check` above
  # (SW global scope, no ES-module syntax), which is a statement about what checks it, not a warning.
  STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' | grep -v 'node_modules\|functions/' | grep -v 'service-worker\.js' | tr '\n' ' ')
  if [[ -n "$STAGED_JS" ]]; then
    # shellcheck disable=SC2086
    ./node_modules/.bin/eslint --max-warnings=0 --no-warn-ignored $STAGED_JS
    if [ $? -ne 0 ]; then
      echo ""
      echo "  ESLint: fix the above warnings/errors, then re-commit."
      echo "  (Run: ./node_modules/.bin/eslint --fix <file> to auto-fix most issues.)"
      exit 1
    fi
  fi
else
  echo "  (node_modules/.bin/eslint not found — run: npm install)"
fi

# service-worker.js syntax check — ESLint is bypassed above; use node --check instead.
if git diff --cached --name-only --diff-filter=ACM | grep -q '^service-worker\.js$'; then
  node --check service-worker.js
  if [ $? -ne 0 ]; then
    echo "  service-worker.js: syntax check failed."
    exit 1
  fi
fi

# Firebase SDK version consistency check — ensures firebase.json functions and
# index.html both reference the same major.minor version of the Firebase JS SDK.
if command -v node >/dev/null 2>&1 && [[ -f "index.html" ]] && [[ -f "firebase-client.js" ]]; then
  node - << 'NODEEOF'
const fs = require('fs');
const clientSrc = fs.readFileSync('firebase-client.js', 'utf8');
const fnPkg = fs.existsSync('functions/package.json') ? JSON.parse(fs.readFileSync('functions/package.json', 'utf8')) : null;
const clientMatch = clientSrc.match(/firebase@(\d+\.\d+)/);
const clientVer = clientMatch ? clientMatch[1] : null;
const fnVer = fnPkg && fnPkg.dependencies && fnPkg.dependencies['firebase-admin']
    ? fnPkg.dependencies['firebase-admin'].replace(/[\^~>=<]*/g, '').split('.').slice(0,2).join('.')
    : null;
// Only warn; SDK versions in browser client vs Admin SDK aren't directly comparable.
// This check catches forgotten bumps within the browser SDK (firebase vs @firebase/app).
const importMatch = clientSrc.match(/firebase@(\d+\.\d+\.\d+)/g);
if (importMatch && importMatch.length > 1) {
    const versions = [...new Set(importMatch.map(s => s.replace('firebase@', '')))];
    if (versions.length > 1) {
        process.stderr.write(`  firebase-sdk: multiple Firebase versions in firebase-client.js: ${versions.join(', ')}\n`);
        process.stderr.write('  Ensure all firebase@x.y.z imports use the same version.\n');
        process.exit(1);
    }
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
fi

# Documentation 0.10-checkpoint — BLOCKING for every versioned .md doc.
# Each doc's version stamp must be at least the latest 0.10 milestone at or below
# APP_VERSION. Mirrors sw-asset-check.test.mjs exactly, so a missed doc sweep fails
# at commit time locally, not only in CI. Covers ALL the docs, not just AI_MAP.
if command -v node >/dev/null 2>&1; then
  node - << 'NODEEOF'
const fs = require('fs');
const toHundredths = v => { const [a, b = '0'] = v.split('.'); return parseInt(a, 10) * 100 + parseInt(b.padEnd(2, '0').slice(0, 2), 10); };

const app = (fs.readFileSync('roster-data.js', 'utf8').match(/export const APP_VERSION = '([\d.]+)'/) || [])[1];
if (!app) process.exit(0);
const milestone = Math.floor(toHundredths(app) / 10) * 10;
const milestoneStr = `v${(milestone / 100).toFixed(2)}`;

const DOCS = [
    { file: 'CLAUDE.md',               re: /Current app version[^`]*`(\d+\.\d+)`/ },
    { file: 'AI_MAP.md',               re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
    { file: 'OPERATIONS_REFERENCE.md', re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
    { file: 'KNOWN_LIMITATIONS.md',    re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
    { file: 'ROADMAP.md',              re: /Last updated:[^\n]*?v(\d+\.\d+)/ },
];

const stale = [];
for (const { file, re } of DOCS) {
    if (!fs.existsSync(file)) continue;
    const m = fs.readFileSync(file, 'utf8').match(re);
    if (!m) { stale.push(`${file} (no version stamp found)`); continue; }
    if (toHundredths(m[1]) < milestone) stale.push(`${file} (v${m[1]})`);
}

if (stale.length) {
    process.stderr.write(`\n  doc-checkpoint: the app has reached the ${milestoneStr} 0.10 milestone (APP_VERSION v${app}),\n`);
    process.stderr.write('  but these docs are behind it (CLAUDE.md policy: all .md docs are swept every 0.10 version):\n');
    for (const s of stale) process.stderr.write(`    - ${s}\n`);
    process.stderr.write(`\n  Review each, apply any needed updates, then bump its stamp to ${milestoneStr} (or later) and re-commit.\n`);
    process.exit(1);
}
NODEEOF
  if [ $? -ne 0 ]; then exit 1; fi
fi

