rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /huddles/{fileName} {
      // READ IS ADMIN-ONLY in all three document blocks. These rules gate only DIRECT
      // Storage SDK reads (get, list, getDownloadURL), and the only direct reader is the
      // admin upload (documents-client.js calls getDownloadURL on the object it has just
      // written). Staff open a document through a URL minted elsewhere — the signed URL
      // from getDocumentUrl, or the stored bearer URL as its fallback — and both bypass
      // these rules. Until the review of Sep 2026 read was `request.auth != null`, which
      // any session satisfied, including an anonymous sign-in: it could LIST the bucket
      // and fetch every file's permanent download token, walking round the v23.18
      // PIN/password decision below. Don't store confidential files here unless the
      // delivery model changes.
      //
      // THE WORDS ARE NOW BEHIND THE PIN TOO (v23.18, owner decision 7 Sep 2026). A DOCX Huddle's
      // converted text is written to the Firestore document as `htmlContent`, and until v23.18
      // `firestore.rules` granted that collection a bare `allow read;` — so the Huddle's words
      // needed no URL and no credential (measured against the live project, 6 Sep 2026). The
      // Firestore read now requires a `name` claim, `admin` or the shared `calendarViewer`, the
      // same doors as `overrides`, and the client refuses the read at source (calendar-doc-access.js).
      // What this file's caution above still means: the FILE behind a bearer URL is fetchable by
      // anyone who already holds the URL — ARCHITECTURE.md EXC-007.
      // Writes come from two paths:
      //   1. ingestHuddle Cloud Function — uses Admin SDK, bypasses these rules entirely.
      //   2. Manual admin upload in operations.html — uses the browser Firebase Storage SDK;
      //      requires an authenticated admin session (admin custom claim == true).
      // Size cap (20 MB) and MIME allowlist prevent abuse of the admin write path.
      // create/update validates size + MIME; delete omits request.resource checks
      // because request.resource is undefined for delete operations and those
      // conditions would always evaluate to false — blocking the browser-side
      // old-file cleanup uploadHuddle() performs when replacing a date's file.
      allow read:           if request.auth != null && request.auth.token.admin == true;
      allow create, update: if request.auth != null
          && request.auth.token.admin == true
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType in [
              'application/pdf',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ];
      allow delete:         if request.auth != null
          && request.auth.token.admin == true;
    }
    match /circulars/{fileName} {
      // Weekly Retail Circular files — PDF or Word (.docx). As with huddles, this read rule only gates direct
      // SDK reads, so it is admin-only; staff open a URL minted elsewhere, which bypasses
      // these rules. Don't store confidential files here.
      // create/update validates size + MIME; delete omits request.resource checks
      // because request.resource is undefined for delete operations and those
      // conditions would always evaluate to false, blocking legitimate pruning.
      allow read:           if request.auth != null && request.auth.token.admin == true;
      allow create, update: if request.auth != null
          && request.auth.token.admin == true
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType in [
              'application/pdf',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ];
      allow delete:         if request.auth != null
          && request.auth.token.admin == true;
    }
    match /newsletters/{fileName} {
      // Marylebone Newsletter files (PDF or Word .docx) — same split (and bearer-URL read model) as circulars.
      allow read:           if request.auth != null && request.auth.token.admin == true;
      allow create, update: if request.auth != null
          && request.auth.token.admin == true
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType in [
              'application/pdf',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ];
      allow delete:         if request.auth != null
          && request.auth.token.admin == true;
    }
// Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
