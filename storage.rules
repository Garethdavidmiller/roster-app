rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /huddles/{fileName} {
      // Huddle files are internal staff briefings — only authenticated staff may read.
      // Writes come from two paths:
      //   1. ingestHuddle Cloud Function — uses Admin SDK, bypasses these rules entirely.
      //   2. Manual admin upload in operations.html — uses the browser Firebase Storage SDK;
      //      requires an authenticated admin session (admin custom claim == true).
      // Size cap (20 MB) and MIME allowlist prevent abuse of the admin write path.
      allow read:  if request.auth != null;
      allow write: if request.auth != null
          && request.auth.token.admin == true
          && request.resource.size < 20 * 1024 * 1024
          && request.resource.contentType in [
              'application/pdf',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ];
    }
    match /avatars/{fileName} {
      // Profile photos. Read requires auth, but tokenised download URLs bypass
      // Storage rules entirely, so <img src> still works on the no-auth calendar
      // page. Write: any signed-in staff member may set their own photo — we
      // cannot scope to the owner reliably (the per-member `name` JWT claim was
      // suspended after a production outage, see KNOWN_LIMITATIONS.md task #2),
      // so this matches the app's auth-only Firestore write posture. Image only,
      // ≤2 MB (client compresses to ~256px, far under). Explicit MIME allowlist
      // (NOT image/.* — that would admit image/svg+xml, which can carry embedded
      // script if the tokenised URL is ever opened as a top-level navigation).
      // On delete, request.resource is null — allow that branch so the
      // Remove-photo button works.
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && (request.resource == null
              || (request.resource.size < 2 * 1024 * 1024
                  && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']));
    }
    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
