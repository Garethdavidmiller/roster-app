rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /huddles/{fileName} {
      // NOTE: this `allow read: if request.auth != null` rule gates only DIRECT
      // Storage SDK reads. Staff don't read Huddle files that way — they open the
      // tokenised bearer download URL saved in the Firestore huddles doc, which
      // carries its own access token and bypasses these rules, so even the anonymous
      // calendar session can open a Huddle. The bearer URL is the real access control
      // (same model as firestore.rules /circulars). Don't store confidential files
      // here unless that delivery model changes.
      //
      // **AND FOR A DOCX HUDDLE THE DELIVERY MODEL HAS ALREADY CHANGED** (measured 6 Sep 2026).
      // The sentence above reasons about the FILE — you need the bearer URL to read it. Since DOCX
      // ingest, the converted text is also written to the Firestore huddles doc as `htmlContent`,
      // and `firestore.rules` grants that collection a bare `allow read;`. So the Huddle's WORDS
      // need no URL and no credential at all: an unauthenticated REST read of /huddles returns them
      // (verified against the live project — the same request against /overrides is denied, which
      // is what v20.12 closed while this collection was left as it was). Nothing here is wrong;
      // the caution above is simply narrower than the exposure. Whether a day plan is confidential
      // is the owner's call, and it has never been recorded — until it is, treat "don't store
      // confidential files here" as also meaning "and don't assume the text is behind the URL".
      // Writes come from two paths:
      //   1. ingestHuddle Cloud Function — uses Admin SDK, bypasses these rules entirely.
      //   2. Manual admin upload in operations.html — uses the browser Firebase Storage SDK;
      //      requires an authenticated admin session (admin custom claim == true).
      // Size cap (20 MB) and MIME allowlist prevent abuse of the admin write path.
      // create/update validates size + MIME; delete omits request.resource checks
      // because request.resource is undefined for delete operations and those
      // conditions would always evaluate to false — blocking the browser-side
      // old-file cleanup uploadHuddle() performs when replacing a date's file.
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null
          && request.auth.token.admin == true
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType in [
              'application/pdf',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ];
      allow delete:         if request.auth != null
          && request.auth.token.admin == true;
    }
    match /circulars/{fileName} {
      // Weekly Retail Circular files — PDF or Word (.docx). As with huddles, this read rule only gates direct
      // SDK reads; staff open the tokenised bearer download URL from the Firestore doc,
      // which bypasses these rules. Don't store confidential files here.
      // create/update validates size + MIME; delete omits request.resource checks
      // because request.resource is undefined for delete operations and those
      // conditions would always evaluate to false, blocking legitimate pruning.
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null
          && request.auth.token.admin == true
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType in [
              'application/pdf',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ];
      allow delete:         if request.auth != null
          && request.auth.token.admin == true;
    }
    match /newsletters/{fileName} {
      // Marylebone Newsletter files (PDF or Word .docx) — same split (and bearer-URL read model) as circulars.
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null
          && request.auth.token.admin == true
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType in [
              'application/pdf',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ];
      allow delete:         if request.auth != null
          && request.auth.token.admin == true;
    }
// Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
