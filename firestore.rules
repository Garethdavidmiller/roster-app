rules_version = '2';
// MYB Roster — Firestore Security Rules
//
// ⚠️  DEPLOYMENT ORDER — READ BEFORE DEPLOYING ⚠️
//
// These rules require Firebase Auth (request.auth != null) for all writes.
// Deploy ONLY AFTER running the "Set up accounts" button in admin.html
// (Admin section → Staff Login Accounts). All staff must have Firebase Auth
// accounts before the rules go live — otherwise every Firestore write fails.
//
// Once the button reports no failures:
//   GitHub → Actions → "Deploy Firestore Rules" → Run workflow
//
// The workflow (deploy-rules.yml) also runs automatically whenever this
// file changes on the main branch.
//
// Last updated: v10.83 — restrict huddle writes to admin; fix Storage rules to allow
//   admin browser uploads (previously `allow write: if false` blocked manual uploads).
// v10.72 — member write isolation (v11 security task #2).
//   overrides: writes now require memberName == request.auth.token.name
//              unless the caller has the admin custom claim (admin == true).
//              admin bypass is required for roster upload (G. Miller writes
//              overrides on behalf of any team member) and for override
//              corrections. source field now required and validated:
//              'manual' | 'roster_import'.
//              delete now checks resource.data.memberName == auth token name.
//   memberSettings: {document=**} wildcard narrowed to {memberName} (flat
//              collection, no subcollections). Writes/deletes now check that
//              the document ID matches the caller's token name, or admin bypass.
//   The admin custom claim is set by setupRosterAuth in functions/index.js
//   with adminMembers=['G. Miller'].

service cloud.firestore {
  match /databases/{database}/documents {

    match /overrides/{document=**} {
      // Intentionally open read: index.html (calendar) reads overrides without a
      // Firebase Auth session. Shift data is operational / non-sensitive (same as
      // the paper noticeboard roster).
      allow read;
      allow create, update: if
        request.auth != null &&
        // Member isolation: each user may only write overrides for themselves.
        // The admin custom claim bypasses this so G. Miller can write for any
        // team member — required for the weekly roster upload pipeline and for
        // admin override corrections.
        (request.resource.data.memberName == request.auth.token.name ||
         request.auth.token.admin == true) &&
        request.resource.data.keys().hasAll(
          ['date', 'memberName', 'type', 'value', 'note', 'source']
        ) &&
        request.resource.data.date is string &&
        request.resource.data.date.size() == 10 &&
        request.resource.data.memberName is string &&
        request.resource.data.memberName.size() > 0 &&
        request.resource.data.memberName.size() < 100 &&
        request.resource.data.type in [
          'spare_shift', 'shift', 'allocated', 'overtime', 'rdw', 'swap',
          'annual_leave', 'correction', 'sick'
        ] &&
        request.resource.data.source in ['manual', 'roster_import'] &&
        request.resource.data.value is string &&
        request.resource.data.value.size() > 0 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() < 500;
      // Delete: staff can only delete their own overrides; admin can delete any.
      allow delete: if
        request.auth != null &&
        (resource.data.memberName == request.auth.token.name ||
         request.auth.token.admin == true);
    }

    match /memberSettings/{memberName} {
      // Faith calendar preferences are personal data — read requires auth.
      // app.js degrades gracefully if this returns 403 (uses cached preferences).
      allow read: if request.auth != null;
      allow create, update: if
        request.auth != null &&
        // Member isolation: staff can only write their own faith calendar setting.
        // The document ID is the member name, so the path check is sufficient.
        (memberName == request.auth.token.name || request.auth.token.admin == true) &&
        request.resource.data.keys().hasAll(['memberName', 'faithCalendar']) &&
        request.resource.data.memberName is string &&
        request.resource.data.faithCalendar in [
          'islamic', 'hindu', 'chinese', 'jamaican',
          'congolese', 'portuguese', 'none'
        ];
      allow delete: if
        request.auth != null &&
        (memberName == request.auth.token.name || request.auth.token.admin == true);
    }

    match /huddles/{date} {
      // Open read: both index.html (Huddle button/viewer, notification auto-open)
      // and admin.html read huddles. index.html has no Firebase Auth session, so
      // requiring auth would break notification auto-open on fresh visits. Huddle
      // briefings are non-sensitive operational content — the actual PDF is behind
      // Firebase Storage. Cloud Function writes use the Admin SDK (bypasses rules).
      allow read;
      // Cloud Function writes use Admin SDK — bypasses these rules entirely.
      // Browser writes (manual admin upload in admin.html) require an admin session.
      // Restricting to admin == true ensures only G. Miller can create/update/delete
      // huddle documents from the browser — all other staff are read-only.
      allow create, update: if
        request.auth != null &&
        request.auth.token.admin == true &&
        request.resource.data.keys().hasAll(['date', 'storageUrl', 'uploadedAt', 'uploadedBy']) &&
        request.resource.data.date is string &&
        request.resource.data.storageUrl is string;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /pushSubscriptions/{docId} {
      // Push subscriptions are written from index.html which is a public page
      // (no login required). The data stored is a browser endpoint URL and
      // encryption keys — not PII. Writes are open so any device can subscribe
      // or unsubscribe without needing a Firebase Auth session.
      allow read: if request.auth != null;
      allow write: if true;
    }

  }
}
