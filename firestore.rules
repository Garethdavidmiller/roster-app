rules_version = '2';
// MYB Roster — Firestore Security Rules
//
// Write policy: any signed-in staff member may write (request.auth != null).
// Field validation is still enforced for data integrity, but per-member
// isolation (v10.72 / v11 task #2) is suspended because it requires custom JWT
// claims that were never reliably deployed, causing a production outage.
// Re-introduce per-member isolation once claims are reliably set via setupRosterAuth.
//
// To re-deploy rules: push a change to this file on main; deploy-rules.yml runs
// automatically. Or: GitHub → Actions → "Deploy Firestore Rules" → Run workflow.
//
// Last updated: v12.06 — linkDesigns collection added (read/write requires auth).
// v12.04 — overrides read required auth (reverted); pushSubscriptions delete requires auth;
//   legacy override types removed from create/update allowlist.
// v11.92 — pushSubscriptions shape validation added.
// v10.94 — revert per-member claim requirement to auth-only.
// v10.83 — restrict huddle writes to admin; fix Storage rules to allow admin uploads.
// v10.72 — member write isolation (v11 task #2). Suspended — see note above.

service cloud.firestore {
  match /databases/{database}/documents {

    match /overrides/{document=**} {
      // Read is intentionally open — no auth required. Override data (AL dates,
      // sick days, shift changes) is readable by anyone with the app URL.
      // This is a known trade-off: requiring auth broke the anonymous calendar view
      // and the anonymous session workaround added unnecessary complexity. The app
      // URL is not publicly advertised and the team is small and known.
      // See KNOWN_LIMITATIONS.md → "Override data is publicly readable".
      allow read;
      allow create, update: if
        request.auth != null &&
        request.resource.data.keys().hasAll(
          ['date', 'memberName', 'type', 'value', 'note', 'source']
        ) &&
        request.resource.data.date is string &&
        request.resource.data.date.size() == 10 &&
        request.resource.data.memberName is string &&
        request.resource.data.memberName.size() > 0 &&
        request.resource.data.memberName.size() < 100 &&
        request.resource.data.type in [
          'spare_shift', 'shift', 'rdw',
          'annual_leave', 'correction', 'sick'
        ] &&
        request.resource.data.source in ['manual', 'roster_import'] &&
        request.resource.data.value is string &&
        request.resource.data.value.size() > 0 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() < 500;
      // Any authenticated user may delete their own overrides. Per-member isolation
      // (limiting deletes to the owning member) is deferred — see KNOWN_LIMITATIONS.md.
      allow delete: if request.auth != null;
    }

    match /memberSettings/{memberName} {
      // Faith calendar preferences are personal data — read requires auth.
      // app.js degrades gracefully if this returns 403 (uses cached preferences).
      allow read: if request.auth != null;
      allow create, update: if
        request.auth != null &&
        request.resource.data.keys().hasAll(['memberName', 'faithCalendar']) &&
        request.resource.data.memberName is string &&
        request.resource.data.faithCalendar in [
          'islamic', 'hindu', 'chinese', 'jamaican',
          'congolese', 'portuguese', 'none'
        ];
      allow delete: if request.auth != null;
    }

    match /huddles/{date} {
      // Open read: index.html reads huddles without a Firebase Auth session —
      // required for Huddle button and notification auto-open on fresh visits.
      allow read;
      // Cloud Function writes use Admin SDK — bypasses these rules entirely.
      // Browser writes (manual admin upload in operations.html) require admin claim.
      // Non-admin staff cannot alter huddle metadata even if authenticated.
      allow create, update: if
        request.auth != null &&
        request.auth.token.admin == true &&
        request.resource.data.keys().hasAll(['date', 'storageUrl', 'uploadedAt', 'uploadedBy']) &&
        request.resource.data.date is string &&
        request.resource.data.storageUrl is string;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /linkDesigns/{document=**} {
      // Link design workspace data — read/write restricted to authenticated users.
      // Client-side: links-app.js redirects anyone not in CONFIG.LINKS_DESIGNERS
      // before any Firestore call is made, so per-designer isolation is not needed here.
      allow read, write: if request.auth != null;
    }

    match /pushSubscriptions/{docId} {
      // Push subscriptions are written from index.html (public, no login required).
      // The stored data is a browser endpoint URL and encryption keys — not PII.
      // Shape validation ensures only well-formed subscription objects are stored.
      allow read: if request.auth != null;
      allow create, update: if
        request.resource.data.keys().hasAll(['endpoint', 'keys', 'subscribedAt']) &&
        request.resource.data.endpoint is string &&
        request.resource.data.endpoint.size() > 0 &&
        request.resource.data.keys is map &&
        request.resource.data.keys.p256dh is string &&
        request.resource.data.keys.auth is string;
      // Anonymous sessions satisfy this — the unsubscribe path in notif.js always has
      // at least an anonymous Auth session from the push subscription flow.
      allow delete: if request.auth != null;
    }

  }
}
