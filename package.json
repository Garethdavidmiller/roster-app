{
  "name": "myb-roster",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:hygiene && npm run test:parse && npm run test:unit",
    "test:hygiene": "node scripts/run-tests.mjs --lane hygiene",
    "test:payslip-local": "PAYSLIP_FIXTURE_REQUIRED=1 node --experimental-test-module-mocks scripts/run-tests.mjs --lane payslip-local",
    "test:parse": "node --experimental-vm-modules scripts/run-tests.mjs --lane parse",
    "test:unit": "node --experimental-test-module-mocks scripts/run-tests.mjs --lane unit",
    "test:rules": "firebase --project demo-myb-roster emulators:exec --only firestore,storage 'node scripts/run-tests.mjs --lane rules'",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:csp": "firebase --project demo-myb-roster emulators:exec --only hosting 'playwright test --config=playwright.csp.mjs'",
    "test:visual": "playwright test --config=playwright.visual.mjs",
    "test:visual:refresh": "node scripts/refresh-visual-baselines.mjs",
    "test:offline": "playwright test --config=playwright.offline.mjs",
    "test:live": "playwright test --config=playwright.live.mjs",
    "test:signed-in": "node scripts/signed-in.mjs playwright test --config=e2e/playwright.signed-in.mjs",
    "test:functions": "node scripts/run-tests.mjs --lane functions",
    "test:nodeps": "node scripts/test-nodeps.mjs",
    "test:mutation": "node scripts/mutation-sweep.mjs",
    "bump": "node scripts/bump-version.mjs",
    "generate:roster-members": "node scripts/generate-roster-members.mjs",
    "generate:guide-index": "node scripts/generate-guide-index.mjs",
    "generate:ai-map": "node scripts/generate-ai-map.mjs",
    "generate:copies": "node scripts/generate-copies.mjs",
    "generate:file-index": "node scripts/generate-file-index.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:webkit": "playwright test --config playwright.webkit.mjs",
    "test:visual:webkit": "playwright test --config=playwright.visual-webkit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.65.0",
    "eslint": "^10.14.0",
    "firebase": "13.2.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "pdfjs-dist": "6.5.438",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "@napi-rs/canvas": "1.1.0"
  }
}
